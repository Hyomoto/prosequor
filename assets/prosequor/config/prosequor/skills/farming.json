  "xpRules": [
    {
      "id": "prosequor:harvest-domesticated-farming",
      "amount": 0.025,
      "pay": "quantity",
      "exclude": ["<seed>"],
      "when": {
        "activity": "prosequor:deed",
        "tags": ["harvested", "domesticated", "target:<crop, berry-bush, fruit-tree>"]
      }
    },
    {
      "id": "prosequor:till-soil",
      "amount": 0.017,
      "when": {
        "activity": "prosequor:deed",
        "tags": ["till-soil"]
      }
    },
    {
      "id": "prosequor:crop-grown-farming",
      "amount": [2, 7, 20],
      "pay": "lifetime",
      "payee": "contributors",
      "when": {
        "activity": "prosequor:deed",
        "tags": ["grown", "domesticated", "target:<crop>"]
      }
    },
    {
      "id": "prosequor:fruit-tree-grown-farming",
      "amount": 2,
      "payee": "maker",
      "when": {
        "activity": "prosequor:deed",
        "tags": ["grown", "domesticated", "target:<fruit-tree>"]
      }
    },
    {
      "id": "prosequor:fertilizer-absorbed",
      "amount": 0.01,
      "payee": "contributors",
      "when": {
        "activity": "prosequor:deed",
        "tags": ["fertilizer-absorbed", "target:<farmland, berry-bush>"]
